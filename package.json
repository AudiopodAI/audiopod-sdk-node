{
  "name": "audiopod",
  "version": "2.10.1",
  "description": "AudioPod AI audio API for Node.js and TypeScript: speech-to-text transcription with speaker diarization, stem separation, text-to-speech, voice cloning, music generation, audio-to-MIDI and noise reduction",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "audiopod": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "node --import tsx --test test/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "audiopod",
    "audio",
    "ai",
    "audio-api",
    "sdk",
    "typescript",
    "speech-to-text",
    "transcription",
    "speaker-diarization",
    "subtitles",
    "text-to-speech",
    "tts",
    "voice-cloning",
    "stem-separation",
    "vocal-remover",
    "karaoke",
    "music-generation",
    "audio-to-midi",
    "noise-reduction",
    "denoiser",
    "mcp",
    "ai-agents"
  ],
  "author": "AudioPod AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AudiopodAI/audiopod-sdk-node.git"
  },
  "homepage": "https://audiopod.ai",
  "bugs": {
    "url": "https://github.com/AudiopodAI/audiopod-sdk-node/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "form-data": "^4.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ws": "^8.5.12",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.0"
  }
}
