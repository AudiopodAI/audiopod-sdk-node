{
  "name": "audiopod-sdk",
  "version": "1.3.0",
  "description": "AudioPod SDK for Node.js - Professional Audio Processing powered by AI",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.js",
      "import": "./dist/index.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src/",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "audiopod",
    "audio",
    "ai",
    "voice",
    "cloning",
    "transcription",
    "stem-separation",
    "music",
    "sdk",
    "typescript"
  ],
  "author": "AudioPod AI <support@audiopod.ai>",
  "license": "MIT",
  "homepage": "https://audiopod.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/AudiopodAI/audiopod-sdk"
  },
  "bugs": {
    "url": "https://github.com/AudiopodAI/audiopod-sdk/issues"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}

