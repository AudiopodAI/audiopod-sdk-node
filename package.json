{
  "name": "audiopod",
  "version": "2.4.0",
  "description": "Official AudioPod SDK + CLI for Node.js - Professional Audio Processing powered by AI",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "audiopod": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "audiopod",
    "audio",
    "ai",
    "speech-to-text",
    "transcription",
    "text-to-speech",
    "tts",
    "voice-cloning",
    "music-generation",
    "stem-separation",
    "denoiser",
    "speaker-diarization"
  ],
  "author": "AudioPod AI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AudiopodAI/audiopod-sdk-node.git"
  },
  "homepage": "https://audiopod.ai",
  "bugs": {
    "url": "https://github.com/AudiopodAI/audiopod-sdk-node/issues"
  },
  "engines": {
    "node": ">=16"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "form-data": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0"
  }
}
